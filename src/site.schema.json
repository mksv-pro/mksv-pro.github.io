{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "site.toml",
  "description": "The site's data (src/site.toml). Checked by tools/build/check.py (tools/build/schema.py); taplo reads it for completion.",
  "type": "object",
  "$defs": {
    "html": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "url": { "type": "string", "pattern": "^(https?://|mailto:|#|\\{\\{)" },
    "href": { "type": "string", "minLength": 1 },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "href"],
        "additionalProperties": false,
        "properties": { "label": { "type": "string", "minLength": 1 }, "href": { "$ref": "#/$defs/href" } }
      }
    },
    "pair": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
    "room": {
      "type": "object",
      "required": ["c", "r", "name", "label"],
      "additionalProperties": false,
      "properties": {
        "c": { "type": "integer", "minimum": 0 }, "r": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" }, "label": { "type": "string" }, "exit": { "type": "string" },
        "img": { "type": "string" }, "page": { "type": "string" }
      }
    }
  },
  "required": ["tabs", "tab_hints", "site", "urls", "person", "education", "cv", "heraldry", "world",
               "experience", "work", "publications", "talks", "teaching", "news"],
  "additionalProperties": false,
  "properties": {
    "tabs": { "type": "array", "minItems": 8, "maxItems": 8, "items": { "$ref": "#/$defs/id" } },
    "tab_hints": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "now": {
      "type": "object", "required": ["date", "text"], "additionalProperties": false,
      "properties": { "date": { "$ref": "#/$defs/date" }, "text": { "$ref": "#/$defs/html" } }
    },
    "internship": {
      "type": "object", "required": ["what", "short", "posts", "fields"], "additionalProperties": false,
      "properties": {
        "what": { "type": "string", "minLength": 1 }, "domain": { "type": "string", "minLength": 1 }, "short": { "type": "string", "minLength": 1, "maxLength": 12 },
        "question": { "$ref": "#/$defs/html" },
        "methods": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "posts": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["kind", "from"], "additionalProperties": false,
            "properties": { "kind": { "type": "string", "minLength": 1 }, "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" } }
          }
        },
        "fields": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["field", "themes"], "additionalProperties": false,
            "properties": {
              "field": { "type": "string", "minLength": 1 },
              "themes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/pair" } }
            }
          }
        }
      }
    },
    "site": {
      "type": "object", "required": ["url", "name", "role", "place", "email", "github"], "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://.+/$" }, "name": { "type": "string" }, "role": { "type": "string" },
        "place": { "type": "string" }, "email": { "type": "string", "pattern": "^[^@\\s]+@[^@\\s]+\\.[a-z]+$" },
        "github": { "$ref": "#/$defs/url" }, "linkedin": { "$ref": "#/$defs/url" }
      }
    },
    "urls": { "type": "object", "additionalProperties": { "$ref": "#/$defs/url" } },
    "person": {
      "type": "object", "required": ["knows_about", "drawn_to", "alumni_of", "languages"], "additionalProperties": false,
      "properties": {
        "knows_about": { "type": "array", "items": { "type": "string" } },
        "drawn_to": { "type": "array", "items": { "type": "string" } },
        "alumni_of": { "type": "array", "items": { "type": "string" } },
        "languages": { "type": "array", "items": { "$ref": "#/$defs/pair" } }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object", "required": ["school", "city", "degree", "dates"], "additionalProperties": false,
        "properties": {
          "logo": { "type": "string", "pattern": "^[a-z0-9-]+\\.png$" },
          "school": { "type": "string" }, "city": { "type": "string" }, "degree": { "$ref": "#/$defs/html" },
          "dates": { "type": "string" }, "href": { "type": "string" }, "coursework": { "type": "string" }, "now": { "type": "boolean" },
          "arms": { "$ref": "#/$defs/id" }, "about": { "type": "string" },
          "cv_degree": { "type": "string" }, "cv_dates": { "type": "string" }, "cv_skip": { "type": "boolean" }
        }
      }
    },
    "cv": {
      "type": "object", "required": ["skills"], "additionalProperties": false,
      "properties": { "keywords": { "type": "string" }, "skills": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "references": { "type": "array", "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } } } }
    },
    "heraldry": {
      "type": "object", "required": ["own", "tapestry"], "additionalProperties": false,
      "properties": {
        "own": { "$ref": "#/$defs/id" },
        "tapestry": { "type": "array", "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } } }
      }
    },
    "world": {
      "type": "object", "required": ["links", "rooms"], "additionalProperties": false,
      "properties": {
        "links": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "rooms": { "type": "object", "additionalProperties": { "$ref": "#/$defs/room" } }
      }
    },
    "experience": {
      "type": "array",
      "items": {
        "type": "object", "required": ["org", "kind", "from", "role"], "additionalProperties": false,
        "properties": {
          "org": { "type": "string" }, "kind": { "enum": ["research", "industry", "teaching", "other"] },
          "from": { "$ref": "#/$defs/date" }, "to": { "$ref": "#/$defs/date" }, "role": { "$ref": "#/$defs/html" },
          "text": { "$ref": "#/$defs/html" }, "logo": { "type": "string", "pattern": "^[a-z0-9-]+\\.png$" }, "actions": { "$ref": "#/$defs/actions" }, "arms": { "$ref": "#/$defs/id" },
          "city": { "type": "string" }, "cv_org": { "type": "string" }, "cv_role": { "type": "string" },
          "cv_text": { "type": "string" }, "cv_bullets": { "type": "array", "items": { "type": "string" } }, "cv_skip": { "type": "boolean" }
        }
      }
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "img", "title", "date", "role", "alt", "text"], "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" }, "img": { "type": "string", "pattern": "^illum-[a-z0-9-]+\\.png$" },
          "at": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "date": { "$ref": "#/$defs/date" },
          "role": { "$ref": "#/$defs/html" }, "alt": { "type": "string", "minLength": 1 }, "text": { "$ref": "#/$defs/html" },
          "actions": { "$ref": "#/$defs/actions" }, "figure": { "type": "string" },
          "city": { "type": "string" }, "cv_title": { "type": "string" }, "cv_role": { "type": "string" },
          "cv_text": { "type": "string" }, "cv_skip": { "type": "boolean" }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "href", "authors", "venue"], "additionalProperties": false,
        "properties": {
          "title": { "type": "string" }, "href": { "$ref": "#/$defs/url" }, "authors": { "type": "string" },
          "venue": { "type": "string" }, "work": { "$ref": "#/$defs/id" }, "bib": { "type": "string", "pattern": "^[\\w.-]+\\.bib$" },
          "actions": { "$ref": "#/$defs/actions" }, "date": { "$ref": "#/$defs/date" }
        }
      }
    },
    "talks": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "date", "venue"], "additionalProperties": false,
        "properties": {
          "title": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "venue": { "type": "string" },
          "thumb": { "type": "string" }, "text": { "$ref": "#/$defs/html" }, "actions": { "$ref": "#/$defs/actions" }
        }
      }
    },
    "teaching": {
      "type": "array",
      "items": {
        "type": "object", "required": ["title", "date", "venue"], "additionalProperties": false,
        "properties": {
          "title": { "type": "string" }, "date": { "$ref": "#/$defs/date" }, "venue": { "type": "string" },
          "level": { "type": "string" }, "hours": { "type": "string" }, "text": { "$ref": "#/$defs/html" },
          "actions": { "$ref": "#/$defs/actions" }
        }
      }
    },
    "coursework": {
      "type": "array",
      "items": {
        "type": "object", "required": ["years", "school", "programme", "courses"], "additionalProperties": false,
        "properties": {
          "years": { "type": "string", "pattern": "^\\d{4}\u2013\\d{4}$" }, "school": { "type": "string" },
          "programme": { "type": "string" }, "on_about": { "type": "boolean" },
          "courses": {
            "type": "array", "minItems": 1,
            "items": { "oneOf": [
              { "type": "string" },
              { "type": "object", "required": ["title", "by"], "additionalProperties": false,
                "properties": { "title": { "type": "string" }, "by": { "type": "string" } } }
            ] }
          }
        }
      }
    },
    "library": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "shelves": { "type": "array", "items": { "$ref": "#/$defs/pair" } },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["shelf", "title", "author"], "additionalProperties": false,
            "properties": {
              "shelf": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "author": { "type": "string" },
              "year": { "type": "integer" }, "url": { "$ref": "#/$defs/url" }, "note": { "type": "string" }
            }
          }
        }
      }
    },
    "news": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["date", "text"], "additionalProperties": false,
        "properties": { "date": { "$ref": "#/$defs/date" }, "msg": { "type": "string" }, "text": { "$ref": "#/$defs/html" } }
      }
    }
  }
}
